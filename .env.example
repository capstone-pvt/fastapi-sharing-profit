# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart_catch
DATABASE_NAME=smart_catch

# JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters. App will refuse to start without these.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_DAYS=7

# File Upload Configuration
UPLOAD_ROOT=uploads

# ML Models Configuration (relative paths resolve from project root)
MODEL_ROOT=app/models
CLASSIFIER_MODEL_PATH=app/models/classifier/best.pt
DETECTOR_MODEL_PATH=app/models/detector/best.pt
WEIGHT_MODEL_PATH=app/models/weight/weight_model.joblib
PRICE_MODEL_PATH=app/models/price/price_model.joblib
DETECTOR_CONFIDENCE=0.25
DETECTOR_IOU=0.45

# CORS: comma-separated list of allowed frontend origins.
# Never use * with allow_credentials=True -- browsers will reject the response.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000

# OpenWeatherMap API Key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Storage backend: "local" or "cloudinary"
STORAGE_BACKEND=local
CLOUDINARY_URL=

# Model preloading (set to false to lazy-load on first request)
PRELOAD_MODELS=true

# Auto-training on sample upload
AUTO_TRAIN_ON_SAMPLE=false
AUTO_TRAIN_ARGS=
