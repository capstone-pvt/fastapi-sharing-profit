# Virtual environment
.venv
.venv-linux/
venv/
env/

docs
# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# ML model files — production models tracked via Git LFS
# (see .gitattributes for LFS patterns)
# Ignore intermediate/temp model files but NOT the deployed ones
*.pth
*.onnx
*.pkl
*.h5
*.tflite
yolov8*.pt

# Ignore training runs and temp model artifacts
runs/
*.pt.bak

# Keep production model files (tracked by Git LFS)
!app/models/classifier/best.pt
!app/models/detector/best.pt
!app/models/weight/weight_model.joblib
!app/models/price/price_model.joblib

# Uploaded files
/uploads/
uploads/

# Downloads and exports
/downloads/
/exports/
exports/

# Datasets (large files)
datasets/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Build artifacts
dist/
build/
*.egg-info/

# Evaluation results
eval_results.json